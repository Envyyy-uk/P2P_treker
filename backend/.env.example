# ============================================================
# Spread Monitor MVP — приклад конфігурації (Фаза 0.1 / 0.2)
# Скопіюйте у .env і заповніть. НІКОЛИ не комітьте реальний .env.
# Вкладені секції — через подвійне підкреслення: SECTION__FIELD
# ============================================================

# dev | staging | production (окремий .env на кожне середовище)
ENVIRONMENT=dev

# ---------- Exchange Config ----------
# API-ключі: ТІЛЬКИ read-права, IP whitelist увімкнено, withdraw — ніколи.
# Окремі ключі для dev/staging/production. Ротація кожні 90 днів
# (docs/security/key-rotation-policy.md).
EXCHANGES__BINANCE__ENABLED=true
EXCHANGES__BINANCE__MAKER_FEE=0.001
EXCHANGES__BINANCE__TAKER_FEE=0.001
EXCHANGES__BINANCE__API_KEY=
EXCHANGES__BINANCE__API_SECRET=
EXCHANGES__BINANCE__API_KEY_CREATED_AT=

EXCHANGES__BYBIT__ENABLED=true
EXCHANGES__BYBIT__MAKER_FEE=0.001
EXCHANGES__BYBIT__TAKER_FEE=0.001
EXCHANGES__BYBIT__API_KEY=
EXCHANGES__BYBIT__API_SECRET=
EXCHANGES__BYBIT__API_KEY_CREATED_AT=

EXCHANGES__OKX__ENABLED=true
EXCHANGES__OKX__MAKER_FEE=0.0008
EXCHANGES__OKX__TAKER_FEE=0.001
EXCHANGES__OKX__API_KEY=
EXCHANGES__OKX__API_SECRET=
EXCHANGES__OKX__API_PASSPHRASE=
EXCHANGES__OKX__API_KEY_CREATED_AT=

# ---------- Trading Config ----------
# Пари задаються JSON-списком канонічних символів (мапінг — app/core/symbols.py)
TRADING__SYMBOLS=["BTC-USDT","ETH-USDT","SOL-USDT","BNB-USDT","XRP-USDT"]
TRADING__MAX_QUOTE_AGE_MS=1000
TRADING__MAX_TIMESTAMP_DIFF_MS=1500
TRADING__SPREAD_THRESHOLD=0.001
TRADING__MIN_EXECUTABLE_QUANTITY=0
TRADING__MIN_EXECUTABLE_NOTIONAL=10

# ---------- Database Config ----------
# enabled=false — запуск без PostgreSQL (лише live-моніторинг, без історії).
DATABASE__ENABLED=true
DATABASE__DSN=postgresql+asyncpg://arb:arb@localhost:5432/arbitrage
DATABASE__WRITE_QUEUE_SIZE=10000
DATABASE__QUEUE_OVERFLOW_POLICY=drop_oldest
DATABASE__BATCH_MAX_ROWS=500
DATABASE__BATCH_MAX_INTERVAL_MS=1000
DATABASE__QUOTES_SAMPLE_INTERVAL_MS=1000
DATABASE__SHUTDOWN_FLUSH_TIMEOUT_S=10

# ---------- WebSocket Config ----------
WEBSOCKET__FRONTEND_PUSH_RATE_HZ=5
WEBSOCKET__CLIENT_QUEUE_SIZE=100
WEBSOCKET__HEARTBEAT_INTERVAL_S=15
WEBSOCKET__MESSAGE_TIMEOUT_S=10
WEBSOCKET__GRACEFUL_SHUTDOWN_TIMEOUT_S=10

# ---------- Logging Config ----------
LOGGING__LEVEL=INFO
LOGGING__JSON_FORMAT=true
LOGGING__MASK_SECRETS=true

# ---------- Security Config ----------
SECURITY__API_KEY_MAX_AGE_DAYS=90
SECURITY__API_KEY_ROTATION_WARNING_DAYS=14

# ---------- Monitoring Config ----------
MONITORING__NTP_SERVERS=["time.cloudflare.com","time.google.com","pool.ntp.org"]
MONITORING__MAX_CLOCK_DRIFT_MS=500
MONITORING__FAIL_ON_CLOCK_DRIFT=true
